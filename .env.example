# 32+ random chars. Signs sessions and derives the credential-vault key. Changing it invalidates stored credentials.
APP_SECRET=

# libSQL: local file in dev, Turso in production (libsql://<db>.turso.io)
DATABASE_URL=file:.data/gr8r.db
DATABASE_AUTH_TOKEN=

# "vercel" = one persistent Vercel Sandbox microVM per agent (default on Vercel)
# "local"  = dev only: a folder + child processes on this machine, NOT isolated
VM_PROVIDER=local

# Only needed for VM_PROVIDER=vercel when running outside Vercel (on Vercel, OIDC is automatic)
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
# Optional VM tuning
# VM_IMAGE=vercel/sandbox/universal
# VM_VCPUS=2

# Public https URL of this app (Telegram webhooks). Auto-detected on Vercel production.
APP_URL=
